{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/dentists-in-lahore", "destination": "/dentists-in-lahore.html" },
    { "source": "/fixed-braces-in-lahore", "destination": "/fixed-braces-in-lahore.html" },
    { "source": "/dental-implants-in-lahore", "destination": "/dental-implants-in-lahore.html" },
    { "source": "/teeth-whitening-in-lahore", "destination": "/teeth-whitening-in-lahore.html" },
    { "source": "/root-canal-in-lahore", "destination": "/root-canal-in-lahore.html" },
    { "source": "/teeth-scaling-in-lahore", "destination": "/teeth-scaling-in-lahore.html" },
    { "source": "/dentist/:slug", "destination": "/dentist/:slug.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://res.cloudinary.com; connect-src 'self' https://dentalappserver.onrender.com; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "geolocation=(self), camera=(), microphone=(), payment=()" }
      ]
    }
  ]
}
